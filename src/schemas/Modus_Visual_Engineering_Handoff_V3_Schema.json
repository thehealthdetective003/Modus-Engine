{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modusassembly.local/schemas/visual-engineering-handoff-v3.schema.json",
  "title": "Modus Assembly Visual Engineering Handoff V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "product",
    "evidence_boundaries",
    "dimensions_and_proportions",
    "geometry_modules",
    "reference_assets",
    "environments",
    "engineering_systems",
    "operational_states",
    "system_relationships",
    "concept_bridges",
    "visual_story_plan",
    "global_prompt_rules"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "contract_type"
      ],
      "properties": {
        "name": {
          "const": "Modus Assembly Visual Engineering Handoff"
        },
        "version": {
          "const": "3.0.0"
        },
        "contract_type": {
          "const": "VISUAL_ONLY_ENGINE_TO_APP_HANDOFF"
        }
      }
    },
    "product": {
      "$ref": "#/$defs/product"
    },
    "evidence_boundaries": {
      "$ref": "#/$defs/evidenceBoundaries"
    },
    "dimensions_and_proportions": {
      "$ref": "#/$defs/dimensions"
    },
    "geometry_modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/geometryModule"
      }
    },
    "reference_assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/referenceAsset"
      }
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/environment"
      }
    },
    "engineering_systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/engineeringSystem"
      }
    },
    "operational_states": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operationalState"
      }
    },
    "system_relationships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/systemRelationship"
      }
    },
    "concept_bridges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/conceptBridge"
      }
    },
    "visual_story_plan": {
      "$ref": "#/$defs/visualStoryPlan"
    },
    "global_prompt_rules": {
      "$ref": "#/$defs/globalPromptRules"
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "enum": [
        "CONFIRMED",
        "CORROBORATED",
        "CREATOR_PROVIDED",
        "ANALYST_INFERRED",
        "UNKNOWN"
      ]
    },
    "claimType": {
      "enum": [
        "FACT",
        "OBSERVATION",
        "GENERAL_PRINCIPLE",
        "PRODUCT_INFERENCE",
        "UNKNOWN"
      ]
    },
    "claimScope": {
      "enum": [
        "PRODUCT_SPECIFIC",
        "OBSERVED_FROM_REFERENCE",
        "GENERAL_ENGINEERING",
        "COMPARATIVE_CONTEXT"
      ]
    },
    "wordingPermission": {
      "enum": [
        "DIRECT",
        "QUALIFIED",
        "CONTEXT_ONLY",
        "EXCLUDE"
      ]
    },
    "visualizationPermission": {
      "enum": [
        "EXACT_ALLOWED",
        "REFERENCE_REQUIRED",
        "GENERIC_PRINCIPLE_ONLY",
        "NOT_ALLOWED"
      ]
    },
    "sourceTier": {
      "enum": [
        "Tier 1",
        "Tier 2",
        "Tier 3",
        "Tier 4",
        "Tier 5",
        "Creator Provided"
      ]
    },
    "contextTruthStatus": {
      "enum": [
        "EXACT_EVENT_VERIFIED",
        "EXACT_LOCATION_VERIFIED",
        "ENVIRONMENT_TYPE_CORROBORATED",
        "CONTEXTUAL_NON_IDENTIFYING",
        "UNUSABLE"
      ]
    },
    "visualFamily": {
      "enum": [
        "OPERATIONAL_CONTEXT",
        "DYNAMIC_TESTING",
        "STATIC_TESTING",
        "FULL_PRODUCT_GEOMETRY",
        "EXTERNAL_FEATURE_DETAIL",
        "COMPONENT_REFERENCE",
        "SYSTEM_CUTAWAY",
        "AIRFLOW_VISUALIZATION",
        "HYDRODYNAMIC_FLOW",
        "STRUCTURAL_LOAD_PATH",
        "PROPULSION_OR_ENERGY_FLOW",
        "SENSOR_OR_SIGNAL_FLOW",
        "CONTROL_RELATIONSHIP",
        "THERMAL_OR_ENVIRONMENTAL_FLOW",
        "SCALE_COMPARISON",
        "HUMAN_OPERATION",
        "PROGRAM_CONTEXT",
        "TECHNICAL_GRAPHIC",
        "MAP_OR_TIMELINE",
        "ARCHIVAL_REFERENCE",
        "HERO_PRODUCT",
        "CHAPTER_TRANSITION",
        "ATMOSPHERIC_INTERSTITIAL"
      ]
    },
    "storyFunction": {
      "enum": [
        "OPENING_HOOK",
        "ESTABLISH_CONTEXT",
        "INTRODUCE_MYSTERY",
        "ESTABLISH_SCALE",
        "SHOW_GEOMETRY",
        "EXPLAIN_PRINCIPLE",
        "EXPLAIN_SYSTEM",
        "SHOW_RELATIONSHIP",
        "SHOW_TRADEOFF",
        "SHOW_EVIDENCE",
        "SHOW_HUMAN_SCALE",
        "COMPARE_SYSTEMS",
        "BRIDGE_CONCEPT",
        "RESET_ATTENTION",
        "PREVIEW_PAYOFF",
        "DELIVER_PAYOFF",
        "CONCLUDE_CHAPTER"
      ]
    },
    "systemCategory": {
      "enum": [
        "MISSION_AND_ENVIRONMENT",
        "GEOMETRY_AND_FLOW",
        "STRUCTURE_AND_LOADS",
        "PROPULSION_AND_POWER",
        "CONTROL_AND_STABILITY",
        "SENSORS_AND_MISSION_SYSTEMS",
        "THERMAL_AND_ENVIRONMENTAL",
        "HUMAN_OPERATION",
        "TEST_AND_VALIDATION",
        "SYSTEM_TRADEOFF",
        "OTHER"
      ]
    },
    "relationshipType": {
      "enum": [
        "FORCE",
        "AIRFLOW",
        "HYDRODYNAMIC",
        "STRUCTURAL_LOAD",
        "ENERGY",
        "THERMAL",
        "CONTROL_SIGNAL",
        "SENSOR_DATA",
        "SPATIAL",
        "CAUSE_AND_EFFECT",
        "TRADEOFF"
      ]
    },
    "productVisibility": {
      "enum": [
        "NONE",
        "PARTIAL",
        "FULL",
        "DETAIL_ONLY"
      ]
    },
    "generationPermission": {
      "enum": [
        "T2V_ALLOWED",
        "REFERENCE_REQUIRED",
        "EDITOR_ONLY",
        "NOT_ALLOWED"
      ]
    },
    "mediaRoute": {
      "enum": [
        "GENERATED_T2V",
        "REFERENCE_IMAGE_I2V",
        "AUTHENTIC_VIDEO",
        "EDITOR_NATIVE_GRAPHIC",
        "REFERENCE_LOCKED_GRAPHIC",
        "STATIC_IMAGE_WITH_MOTION",
        "NO_VALID_ROUTE"
      ]
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "confidence"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_name",
        "exact_variant_or_configuration",
        "product_class",
        "developer_or_design_authority_if_confirmed",
        "operator_or_customer_if_confirmed",
        "program_status",
        "aliases",
        "overall_visual_description",
        "immutable_identity_features",
        "visually_similar_products_to_avoid",
        "global_negative_constraints"
      ],
      "properties": {
        "official_name": {
          "type": "string"
        },
        "exact_variant_or_configuration": {
          "type": "string"
        },
        "product_class": {
          "type": "string"
        },
        "developer_or_design_authority_if_confirmed": {
          "type": "string"
        },
        "operator_or_customer_if_confirmed": {
          "type": "string"
        },
        "program_status": {
          "type": "string"
        },
        "aliases": {
          "$ref": "#/$defs/stringArray"
        },
        "overall_visual_description": {
          "type": "string"
        },
        "immutable_identity_features": {
          "$ref": "#/$defs/stringArray"
        },
        "visually_similar_products_to_avoid": {
          "$ref": "#/$defs/stringArray"
        },
        "global_negative_constraints": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim",
        "claim_type",
        "claim_scope",
        "source_url_or_creator_reference",
        "source_tier",
        "confidence",
        "wording_permission",
        "visualization_permission",
        "qualifier_required",
        "notes"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^CLM_[A-Za-z0-9_-]+$"
        },
        "claim": {
          "type": "string"
        },
        "claim_type": {
          "$ref": "#/$defs/claimType"
        },
        "claim_scope": {
          "$ref": "#/$defs/claimScope"
        },
        "source_url_or_creator_reference": {
          "type": "string"
        },
        "source_tier": {
          "$ref": "#/$defs/sourceTier"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "wording_permission": {
          "$ref": "#/$defs/wordingPermission"
        },
        "visualization_permission": {
          "$ref": "#/$defs/visualizationPermission"
        },
        "qualifier_required": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "evidenceBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_evidence_ceiling",
        "confirmed_product_specific_scope",
        "observable_scope",
        "general_principles_allowed",
        "qualified_product_inferences",
        "unknowns",
        "excluded_claims",
        "claims"
      ],
      "properties": {
        "overall_evidence_ceiling": {
          "type": "string"
        },
        "confirmed_product_specific_scope": {
          "$ref": "#/$defs/stringArray"
        },
        "observable_scope": {
          "$ref": "#/$defs/stringArray"
        },
        "general_principles_allowed": {
          "$ref": "#/$defs/stringArray"
        },
        "qualified_product_inferences": {
          "$ref": "#/$defs/stringArray"
        },
        "unknowns": {
          "$ref": "#/$defs/stringArray"
        },
        "excluded_claims": {
          "$ref": "#/$defs/stringArray"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_length",
        "overall_width_or_wingspan",
        "overall_height",
        "important_proportion_rules",
        "human_scale_reference"
      ],
      "properties": {
        "overall_length": {
          "$ref": "#/$defs/measurement"
        },
        "overall_width_or_wingspan": {
          "$ref": "#/$defs/measurement"
        },
        "overall_height": {
          "$ref": "#/$defs/measurement"
        },
        "important_proportion_rules": {
          "$ref": "#/$defs/stringArray"
        },
        "human_scale_reference": {
          "type": "string"
        }
      }
    },
    "geometryModule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "module_name",
        "required_visible_features",
        "minimum_visible_anchor_count",
        "forbidden_geometry_changes",
        "likely_wrong_substitutions",
        "reference_asset_ids"
      ],
      "properties": {
        "module_id": {
          "type": "string"
        },
        "module_name": {
          "type": "string"
        },
        "required_visible_features": {
          "$ref": "#/$defs/stringArray"
        },
        "minimum_visible_anchor_count": {
          "type": "integer",
          "minimum": 0
        },
        "forbidden_geometry_changes": {
          "$ref": "#/$defs/stringArray"
        },
        "likely_wrong_substitutions": {
          "$ref": "#/$defs/stringArray"
        },
        "reference_asset_ids": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "referenceAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "asset_type",
        "product_or_component",
        "exact_variant_or_configuration",
        "operational_state_or_context",
        "view_angle",
        "source_page_url",
        "direct_media_url_or_file_reference",
        "publisher_or_owner",
        "date_or_event",
        "visual_verification",
        "context_truth_status",
        "exact_event_or_location_verified",
        "visible_geometry_features",
        "allowed_usage",
        "forbidden_usage",
        "recommended_media_routes",
        "confidence"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^REF_[A-Za-z0-9_-]+$"
        },
        "asset_type": {
          "enum": [
            "IMAGE",
            "VIDEO",
            "PDF",
            "DIAGRAM",
            "WEB_PAGE",
            "CREATOR_FILE",
            "OTHER"
          ]
        },
        "product_or_component": {
          "type": "string"
        },
        "exact_variant_or_configuration": {
          "type": "string"
        },
        "operational_state_or_context": {
          "type": "string"
        },
        "view_angle": {
          "type": "string"
        },
        "source_page_url": {
          "type": "string"
        },
        "direct_media_url_or_file_reference": {
          "type": "string"
        },
        "publisher_or_owner": {
          "type": "string"
        },
        "date_or_event": {
          "type": "string"
        },
        "visual_verification": {
          "enum": [
            "PASS",
            "PARTIAL",
            "FAIL"
          ]
        },
        "context_truth_status": {
          "$ref": "#/$defs/contextTruthStatus"
        },
        "exact_event_or_location_verified": {
          "type": "boolean"
        },
        "visible_geometry_features": {
          "$ref": "#/$defs/stringArray"
        },
        "allowed_usage": {
          "$ref": "#/$defs/stringArray"
        },
        "forbidden_usage": {
          "$ref": "#/$defs/stringArray"
        },
        "recommended_media_routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mediaRoute"
          }
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_id",
        "environment_name",
        "setting_scope",
        "environment_type",
        "context_truth_status",
        "exact_event_or_location_if_verified",
        "geographic_or_environmental_context",
        "physical_features",
        "ground_water_or_surface",
        "weather_and_atmosphere",
        "lighting",
        "equipment_and_supports",
        "human_roles",
        "uniforms_and_ppe",
        "scale_references",
        "allowed_background_activity",
        "forbidden_elements"
      ],
      "properties": {
        "environment_id": {
          "type": "string",
          "pattern": "^ENV_[A-Za-z0-9_-]+$"
        },
        "environment_name": {
          "type": "string"
        },
        "setting_scope": {
          "enum": [
            "INTERIOR",
            "EXTERIOR",
            "AERIAL",
            "UNDERWATER",
            "AT_SEA",
            "RUNWAY",
            "TEST_RANGE",
            "LABORATORY",
            "OPERATIONAL",
            "GRAPHIC",
            "OTHER"
          ]
        },
        "environment_type": {
          "type": "string"
        },
        "context_truth_status": {
          "$ref": "#/$defs/contextTruthStatus"
        },
        "exact_event_or_location_if_verified": {
          "type": "string"
        },
        "geographic_or_environmental_context": {
          "type": "string"
        },
        "physical_features": {
          "$ref": "#/$defs/stringArray"
        },
        "ground_water_or_surface": {
          "type": "string"
        },
        "weather_and_atmosphere": {
          "type": "string"
        },
        "lighting": {
          "type": "string"
        },
        "equipment_and_supports": {
          "$ref": "#/$defs/stringArray"
        },
        "human_roles": {
          "$ref": "#/$defs/stringArray"
        },
        "uniforms_and_ppe": {
          "$ref": "#/$defs/stringArray"
        },
        "scale_references": {
          "$ref": "#/$defs/stringArray"
        },
        "allowed_background_activity": {
          "$ref": "#/$defs/stringArray"
        },
        "forbidden_elements": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "visualOpportunities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommended_visual_families",
        "full_product_opportunities",
        "external_detail_opportunities",
        "reference_supported_internal_opportunities",
        "general_principle_graphic_opportunities",
        "force_flow_energy_signal_opportunities",
        "testing_opportunities",
        "human_operation_opportunities",
        "non_product_cutaway_opportunities"
      ],
      "properties": {
        "recommended_visual_families": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/visualFamily"
          }
        },
        "full_product_opportunities": {
          "$ref": "#/$defs/stringArray"
        },
        "external_detail_opportunities": {
          "$ref": "#/$defs/stringArray"
        },
        "reference_supported_internal_opportunities": {
          "$ref": "#/$defs/stringArray"
        },
        "general_principle_graphic_opportunities": {
          "$ref": "#/$defs/stringArray"
        },
        "force_flow_energy_signal_opportunities": {
          "$ref": "#/$defs/stringArray"
        },
        "testing_opportunities": {
          "$ref": "#/$defs/stringArray"
        },
        "human_operation_opportunities": {
          "$ref": "#/$defs/stringArray"
        },
        "non_product_cutaway_opportunities": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "engineeringSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "system_name",
        "system_category",
        "engineering_question",
        "engineering_problem",
        "operating_environment",
        "observable_clues",
        "confirmed_product_specific_findings",
        "applicable_general_principles",
        "qualified_product_inferences",
        "governing_constraints",
        "system_inputs",
        "system_outputs",
        "interacting_system_ids",
        "tradeoffs",
        "test_or_operational_evidence",
        "unknowns_and_limits",
        "geometry_module_ids",
        "operational_state_ids",
        "reference_asset_ids",
        "evidence_claim_ids",
        "visual_opportunities"
      ],
      "properties": {
        "system_id": {
          "type": "string",
          "pattern": "^SYS_[A-Za-z0-9_-]+$"
        },
        "system_name": {
          "type": "string"
        },
        "system_category": {
          "$ref": "#/$defs/systemCategory"
        },
        "engineering_question": {
          "type": "string"
        },
        "engineering_problem": {
          "type": "string"
        },
        "operating_environment": {
          "type": "string"
        },
        "observable_clues": {
          "$ref": "#/$defs/stringArray"
        },
        "confirmed_product_specific_findings": {
          "$ref": "#/$defs/stringArray"
        },
        "applicable_general_principles": {
          "$ref": "#/$defs/stringArray"
        },
        "qualified_product_inferences": {
          "$ref": "#/$defs/stringArray"
        },
        "governing_constraints": {
          "$ref": "#/$defs/stringArray"
        },
        "system_inputs": {
          "$ref": "#/$defs/stringArray"
        },
        "system_outputs": {
          "$ref": "#/$defs/stringArray"
        },
        "interacting_system_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "tradeoffs": {
          "$ref": "#/$defs/stringArray"
        },
        "test_or_operational_evidence": {
          "$ref": "#/$defs/stringArray"
        },
        "unknowns_and_limits": {
          "$ref": "#/$defs/stringArray"
        },
        "geometry_module_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "operational_state_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "reference_asset_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "evidence_claim_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "visual_opportunities": {
          "$ref": "#/$defs/visualOpportunities"
        }
      }
    },
    "operationalState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "state_name",
        "state_purpose",
        "environment_ids",
        "product_configuration",
        "required_visible_identity_anchors",
        "geometry_module_ids",
        "opening_state",
        "primary_action",
        "midpoint_event",
        "propulsion_or_control_behavior",
        "physical_environmental_response",
        "stable_ending_state",
        "camera_platform_options",
        "preferred_shot_scales",
        "preferred_camera_movements",
        "forbidden_camera_movements",
        "continuity_requirements",
        "forbidden_configuration_changes",
        "reference_asset_ids",
        "evidence_claim_ids",
        "generation_permission"
      ],
      "properties": {
        "state_id": {
          "type": "string",
          "pattern": "^OPS_[A-Za-z0-9_-]+$"
        },
        "state_name": {
          "type": "string"
        },
        "state_purpose": {
          "type": "string"
        },
        "environment_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "product_configuration": {
          "type": "string"
        },
        "required_visible_identity_anchors": {
